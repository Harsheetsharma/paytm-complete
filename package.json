{
  "name": "week-18",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && turbo build --filter=./apps/user-app",
    "dev": "turbo dev",
    "user-app": "cd ./apps/user-app && npm run dev",
    "lint": "turbo lint",
    "db:generate": "cd packages/db && npx prisma generate && cd ../..",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start-user-app": "cd ./apps/user-app && npm run start"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.16.0",
    "react-toastify": "^11.0.5",
    "recoil": "^0.7.7"
  }
}
